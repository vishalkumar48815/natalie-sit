# Copy to .env.local and fill in.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nataliesit.com

# Contact form delivery via Resend (https://resend.com). Without these,
# submissions are logged to the server console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Natalie Sit Website <hello@yourdomain.com>"

# Newsletter: any webhook that accepts { email, source } JSON
# (Zapier/Make, ConvertKit form endpoint, etc.). Optional.
NEWSLETTER_WEBHOOK_URL=
